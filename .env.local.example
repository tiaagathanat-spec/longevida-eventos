# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Banco de dados (Prisma/tooling de acesso direto)
# USAR o pooler em MODO TRANSAÇÃO (porta 6543) para não ficar no limite de
# 15 conexões simultâneas do modo sessão (porta 5432).
# Formato: postgresql://postgres.<REF>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# OBS: o app em produção usa o cliente Supabase (PostgREST/REST), sem esse limite.
DATABASE_URL=

# Gateway de pagamento (a definir)
PAYMENT_GATEWAY_SECRET=
